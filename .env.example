# PostgreSQL connection string (docker-compose default shown)
DATABASE_URL=postgresql://squared:squared@localhost:5432/squared

# Secret used to sign JWT session tokens (generate: openssl rand -hex 32)
JWT_SECRET=

# Stripe API keys (test mode: https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Webhook signing secret (from `stripe listen` locally, or the dashboard endpoint config)
STRIPE_WEBHOOK_SECRET=

# Base URL of the app, used for Stripe onboarding return/refresh URLs
APP_URL=http://localhost:3000
