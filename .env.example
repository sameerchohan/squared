# PostgreSQL connection string (docker-compose default shown)
DATABASE_URL=postgresql://squared:squared@localhost:5432/squared

# Local Postgres has no TLS; omit this in production so RDS connections are
# verified against the bundled CA set.
PGSSLMODE=disable

# Secret used to sign JWT session tokens (generate: openssl rand -hex 32)
JWT_SECRET=

# Stripe secret key (test mode: https://dashboard.stripe.com/test/apikeys).
# In production this is injected from AWS Secrets Manager, never set here.
STRIPE_SECRET_KEY=

# Webhook signing secret (from `stripe listen` locally, or the dashboard
# endpoint config in production)
STRIPE_WEBHOOK_SECRET=

# Base URL of the app, used for Stripe onboarding and checkout return URLs and
# for the link in a password reset email. Never derived from the request host:
# that is attacker-controlled, and a reset link built from it could be pointed
# at someone else's server.
APP_URL=http://localhost:3000

# Transactional email, used only for password reset links (https://resend.com).
# Leave both unset in development: the reset link is written to the server log
# instead of being sent, which is enough to complete the flow locally.
# EMAIL_FROM must be an address at a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=
